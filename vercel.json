{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.zapier.com; style-src 'self' 'unsafe-inline' https://cdn.zapier.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://*.zapier.com; upgrade-insecure-requests" },
                { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/functions/:path*",
            "has": [{ "type": "host", "value": "api.crewform.tech" }],
            "destination": "https://abdyecfppehskxcxgppp.supabase.co/functions/:path*"
        },
        {
            "source": "/rest/:path*",
            "has": [{ "type": "host", "value": "api.crewform.tech" }],
            "destination": "https://abdyecfppehskxcxgppp.supabase.co/rest/:path*"
        },
        {
            "source": "/auth/:path*",
            "has": [{ "type": "host", "value": "api.crewform.tech" }],
            "destination": "https://abdyecfppehskxcxgppp.supabase.co/auth/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
